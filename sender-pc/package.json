{
  "name": "projector-cast",
  "productName": "Projector Cast",
  "version": "1.13.3",
  "description": "Screen and audio mirroring from Windows to Android TV projectors.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "build": {
    "appId": "com.projectorcast.sender",
    "productName": "Projector Cast",
    "files": [
      "main.js",
      "preload.js",
      "cast-core.js",
      "renderer.js",
      "index.html",
      "style.css"
    ],
    "directories": {
      "output": "../dist/pc"
    },
    "artifactName": "ProjectorCast-${version}-${arch}.${ext}",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "../dist/ProjectorCast.apk",
        "to": "ProjectorCast.apk"
      },
      {
        "from": "../dist/ProjectorCast.version",
        "to": "ProjectorCast.version"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Projector Cast",
      "artifactName": "ProjectorCast-Setup-${version}.exe",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "ambroseonapa",
      "repo": "projector-cast",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.utilities",
      "artifactName": "ProjectorCast-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Projector Cast captures the screen to show it on the projector."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "ProjectorCast-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "author": "Ambrose Onapa",
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "repository": "https://github.com/ambroseonapa/projector-cast"
}
